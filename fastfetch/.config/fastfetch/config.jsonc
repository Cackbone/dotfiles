{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.local/share/wallpapers/portrait.png",
    // width only: kitty derives the height from the image, so the ratio is kept
    "width": 38,
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "magenta", "title": "cyan" },
    "key": { "width": 12 }
  },
  "modules": [
    "break",
    "title",
    { "type": "separator", "string": "─" },
    { "type": "os",       "key": "OS" },
    { "type": "host",     "key": "Host" },
    { "type": "kernel",   "key": "Kernel" },
    { "type": "uptime",   "key": "Uptime" },
    { "type": "packages", "key": "Packages" },
    { "type": "shell",    "key": "Shell" },
    { "type": "display",  "key": "Display", "compactType": "original-with-refresh-rate" },
    { "type": "wm",       "key": "WM" },
    { "type": "terminal", "key": "Terminal" },
    { "type": "cpu",      "key": "CPU" },
    { "type": "gpu",      "key": "GPU" },
    { "type": "memory",   "key": "Memory" },
    { "type": "disk",     "key": "Disk", "folders": "/" },
    "break",
    { "type": "colors", "symbol": "square" }
  ]
}
