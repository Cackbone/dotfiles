// niri — scrollable-tiling Wayland compositor
// Docs: https://github.com/YaLTeR/niri/wiki/Configuration:-Introduction
// Palette (synthwave): see README.md
//   navy #131244  deep #090d17  magenta #e040fb  purple #7b2cbf
//   cyan #00bcd4  ice #76e6f2   lime #69ff47     pink-red #ff4f79

input {
    keyboard {
        xkb {
            layout "fr"
        }
        numlock
    }
    touchpad {
        tap
        natural-scroll
        dwt
    }
    mouse {
        accel-profile "flat"
    }
    // Focus follows mouse, but never scroll the strip just because the pointer moved.
    focus-follows-mouse max-scroll-amount="0%"
    warp-mouse-to-focus
}

// Same arrangement as ~/.screenlayout/home.sh (i3). Run `niri msg outputs` to check names.
output "DP-1" {
    mode "2560x1440"
    position x=0 y=0
}
output "HDMI-A-2" {
    mode "1920x1080"
    position x=2560 y=180
}
output "eDP-1" {
    mode "1920x1080"
    position x=4480 y=180
}

layout {
    gaps 14
    center-focused-column "never"
    always-center-single-column

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    // Let the wallpaper (placed in the backdrop, see layer-rule below) show through.
    background-color "transparent"

    focus-ring {
        off
    }

    border {
        width 3
        active-color "#e040fb"
        inactive-color "#3b2a78"
        urgent-color "#ff4f79"
    }

    // flat look: no shadows, no transparency, no blur
    shadow {
        off
    }

    tab-indicator {
        width 4
        gap 6
        active-color "#e040fb"
        inactive-color "#3b2a78"
    }

    struts {
        top 4
    }
}

overview {
    zoom 0.45
    backdrop-color "#090d17"
    workspace-shadow {
        off
    }
}

// Wallpaper stays still while you scroll the canvas and zoom out in the overview.
layer-rule {
    match namespace="^wallpaper$"
    place-within-backdrop true
}

// glass bar: blur whatever is behind waybar (its CSS background is translucent)
blur {
    passes 3
    offset 3.0
    noise 0.02
    saturation 1.2
}
layer-rule {
    match namespace="^waybar$"
    geometry-corner-radius 18
    background-effect {
        blur true
    }
}

layer-rule {
    match namespace="^notifications$"
    block-out-from "screencast"
}

// Square windows with thick borders, like the mockup.
window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
}

window-rule {
    match app-id="^pavucontrol$"
    match app-id="^org.pulseaudio.pavucontrol$"
    match app-id="^nm-connection-editor$"
    match title="^Picture-in-Picture$"
    match app-id="^thunar$" title="^File Operation Progress$"
    open-floating true
}

// the nowplaying mini player: a small floating window
window-rule {
    match app-id="^nowplaying$"
    open-floating true
    default-column-width { fixed 760; }
    default-window-height { fixed 300; }
}

window-rule {
    match app-id="^org.keepassxc.KeePassXC$"
    match app-id="^Bitwarden$"
    block-out-from "screen-capture"
}

spawn-at-startup "waybar"
spawn-at-startup "mako"
// Spotify in the background (Connect device + MPRIS): nowplaying (Mod+F7), bar, media keys
spawn-sh-at-startup "RUST_LOG=spotify_player=info,librespot=info,spotify_player::cli=warn spotify_player --daemon"
spawn-sh-at-startup "swaybg -m fill -i ~/.local/share/wallpapers/night-city@2x.png"
spawn-sh-at-startup "swayidle -w timeout 600 'swaylock -f' timeout 900 'niri msg action power-off-monitors' before-sleep 'swaylock -f'"
spawn-sh-at-startup "wl-paste --watch cliphist store"

environment {
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    QT_QPA_PLATFORM "wayland;xcb"
    _JAVA_AWT_WM_NONREPARENTING "1"
}

prefer-no-csd
screenshot-path "~/Pictures/Screenshots/%Y-%m-%d_%H-%M-%S.png"

hotkey-overlay {
    skip-at-startup
}

animations {
    window-open {
        duration-ms 180
        curve "ease-out-expo"
    }
}

// Keybinds mirror the old i3 config (AZERTY, jklm = left/down/up/right).
// Like i3, focus/move continue onto the next monitor at the edge of a screen.
// Mod+Shift+, (i.e. Mod+?) shows them all.
binds {
    Mod+Shift+Comma { show-hotkey-overlay; }

    // --- apps ---
    Mod+Return hotkey-overlay-title="Terminal" { spawn "kitty"; }
    Mod+D hotkey-overlay-title="Launcher" { spawn-sh "rofi -show drun -theme ~/.config/rofi/launchers/type-6/synthwave.rasi"; }
    Mod+V hotkey-overlay-title="Clipboard history" { spawn-sh "cliphist list | rofi -dmenu -theme ~/.config/rofi/launchers/type-6/synthwave.rasi | cliphist decode | wl-copy"; }
    Mod+F1 { spawn "firefox"; }
    Mod+F2 { spawn "discord"; }
    Mod+F3 { spawn "thunar"; }
    Mod+E hotkey-overlay-title="Files (yazi)" { spawn "kitty" "--class" "yazi" "yazi"; }
    Mod+F5 { spawn "emacs"; }
    Mod+F7 hotkey-overlay-title="Now playing" { spawn "kitty" "--class" "nowplaying" "--title" "nowplaying" "nowplaying"; }
    Mod+Alt+L hotkey-overlay-title="Lock screen" { spawn "swaylock"; }

    // --- media / hardware keys ---
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "pactl set-sink-volume @DEFAULT_SINK@ +5%"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "pactl set-sink-volume @DEFAULT_SINK@ -5%"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "pactl set-sink-mute @DEFAULT_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "pactl set-source-mute @DEFAULT_SOURCE@ toggle"; }
    XF86AudioPlay        allow-when-locked=true { spawn-sh "~/.local/bin/music-ctl play-pause"; }
    XF86AudioPause       allow-when-locked=true { spawn "playerctl" "pause"; }
    XF86AudioStop        allow-when-locked=true { spawn "playerctl" "stop"; }
    XF86AudioNext        allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev        allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "set" "+5%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }

    // --- the canvas ---
    Mod+Tab repeat=false { toggle-overview; }
    Mod+O   repeat=false { toggle-overview; }

    Mod+Shift+A repeat=false { close-window; }

    Mod+J     { focus-column-or-monitor-left; }
    Mod+K     { focus-window-or-monitor-down; }
    Mod+L     { focus-window-or-monitor-up; }
    Mod+M     { focus-column-or-monitor-right; }
    Mod+Left  { focus-column-or-monitor-left; }
    Mod+Down  { focus-window-or-monitor-down; }
    Mod+Up    { focus-window-or-monitor-up; }
    Mod+Right { focus-column-or-monitor-right; }

    Mod+Shift+J     { move-column-left-or-to-monitor-left; }
    Mod+Shift+K     { move-window-down; }
    Mod+Shift+L     { move-window-up; }
    Mod+Shift+M     { move-column-right-or-to-monitor-right; }
    Mod+Shift+Left  { move-column-left-or-to-monitor-left; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Right { move-column-right-or-to-monitor-right; }

    Mod+Home       { focus-column-first; }
    Mod+End        { focus-column-last; }
    Mod+Shift+Home { move-column-to-first; }
    Mod+Shift+End  { move-column-to-last; }

    // monitors
    Mod+Ctrl+Left        { focus-monitor-left; }
    Mod+Ctrl+Right       { focus-monitor-right; }
    Mod+Ctrl+Up          { focus-monitor-up; }
    Mod+Ctrl+Down        { focus-monitor-down; }
    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }

    // workspaces are vertical: scroll up/down between them
    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+Shift+Page_Down { move-column-to-workspace-down; }
    Mod+Shift+Page_Up   { move-column-to-workspace-up; }

    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollRight                     { focus-column-right; }
    Mod+WheelScrollLeft                      { focus-column-left; }
    Mod+Shift+WheelScrollDown                { focus-column-right; }
    Mod+Shift+WheelScrollUp                  { focus-column-left; }

    // AZERTY number row, like i3
    Mod+ampersand  { focus-workspace 1; }
    Mod+eacute     { focus-workspace 2; }
    Mod+quotedbl   { focus-workspace 3; }
    Mod+apostrophe { focus-workspace 4; }
    Mod+parenleft  { focus-workspace 5; }
    Mod+minus      { focus-workspace 6; }
    Mod+egrave     { focus-workspace 7; }
    Mod+underscore { focus-workspace 8; }
    Mod+ccedilla   { focus-workspace 9; }
    Mod+Shift+ampersand  { move-column-to-workspace 1; }
    Mod+Shift+eacute     { move-column-to-workspace 2; }
    Mod+Shift+quotedbl   { move-column-to-workspace 3; }
    Mod+Shift+apostrophe { move-column-to-workspace 4; }
    Mod+Shift+parenleft  { move-column-to-workspace 5; }
    Mod+Shift+minus      { move-column-to-workspace 6; }
    Mod+Shift+egrave     { move-column-to-workspace 7; }
    Mod+Shift+underscore { move-column-to-workspace 8; }
    Mod+Shift+ccedilla   { move-column-to-workspace 9; }

    // columns: stack windows into one column / pop them out
    Mod+Comma     { consume-or-expel-window-left; }
    Mod+Semicolon { consume-or-expel-window-right; }
    Mod+Z         { toggle-column-tabbed-display; }

    // sizing (i3's resize mode → presets + nudges)
    Mod+R       { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R  { reset-window-height; }
    Mod+F       { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Ctrl+F  { expand-column-to-available-width; }
    Mod+C       { center-column; }
    Mod+Alt+Left  { set-column-width "-10%"; }
    Mod+Alt+Right { set-column-width "+10%"; }
    Mod+Alt+Up    { set-window-height "-10%"; }
    Mod+Alt+Down  { set-window-height "+10%"; }

    // floating
    Mod+Ctrl+Space { toggle-window-floating; }
    Mod+Space      { switch-focus-between-floating-and-tiling; }

    // screenshots (built in: select region, then Space/Enter to capture)
    Print      { screenshot; }
    Mod+F4     { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print  { screenshot-window; }

    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+E { quit; }
    Mod+Shift+P { power-off-monitors; }
}
