# Synthwave syntax highlighting (palette: see README.md). Loaded after fish's generated
# conf.d/fish_frozen_theme.fish (alphabetical order), so these win without editing that file.
status is-interactive; or return
set -g fish_color_normal         e8e6ff
set -g fish_color_command        76e6f2
set -g fish_color_keyword        e040fb
set -g fish_color_param          e8e6ff
set -g fish_color_option         c8c6ef
set -g fish_color_quote          69ff47
set -g fish_color_redirection    e040fb
set -g fish_color_end            e040fb
set -g fish_color_operator       f07cff
set -g fish_color_escape         00bcd4
set -g fish_color_error          ff4f79
set -g fish_color_comment        4a4a8a --italics
set -g fish_color_autosuggestion 4a4a8a
set -g fish_color_valid_path     --underline
set -g fish_color_cwd            76e6f2
set -g fish_color_cwd_root       ff4f79
set -g fish_color_user           e040fb
set -g fish_color_host           c8c6ef
set -g fish_color_status         ff4f79
set -g fish_color_cancel         --reverse
set -g fish_color_selection      --background=3b2a78
set -g fish_color_search_match   --background=3b2a78
set -g fish_color_history_current --bold
set -g fish_pager_color_completion          e8e6ff
set -g fish_pager_color_description         8b8bc7
set -g fish_pager_color_prefix              e040fb --bold
set -g fish_pager_color_progress            131244 --background=e040fb
set -g fish_pager_color_selected_background --background=3b2a78
